# Hardware/Vivado generated output. Keep source skeletons under hw/, but do
# not let local Vivado runs or bitstreams enter the main repository.
hw/**/.Xil/
hw/**/*.jou
hw/**/*.log
hw/**/*.str
hw/**/*.wdb
hw/**/*.wlf
hw/**/*.bit
hw/**/*.ltx
hw/**/*.dcp
hw/**/*.rpt
hw/**/*.runs/
hw/**/*.cache/
hw/**/*.sim/
hw/**/*.gen/
hw/**/ip_user_files/
hw/prebuilt/*
!hw/prebuilt/README.md

# XDMA is vendored as source. Local kernel/tool builds stay untracked.
xdma/xdma/*.ko
xdma/xdma/*.o
xdma/xdma/.*.o
xdma/xdma/.*.o.cmd
xdma/xdma/.*.cmd
xdma/xdma/*.mod
xdma/xdma/*.mod.c
xdma/xdma/*.order
xdma/xdma/Module.symvers
xdma/tools/dma_from_device
xdma/tools/dma_to_device
xdma/tools/performance
xdma/tools/reg_rw
xdma/tools/test_chrdev
